# ==============================================================================
# Kisaan Dost Production Environment Configuration Template
# ==============================================================================

# Backend API Configuration
API_BASE_URL=http://192.168.1.5:8000

# Google Gemini Live Multimodal API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here

# Gemini Live WebSocket and Model Settings
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent

# Supabase Storage & Telemetry
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# App Environment Metadata
APP_VERSION=1.0.0
ENVIRONMENT=production
