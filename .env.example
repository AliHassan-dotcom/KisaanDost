# ==============================================================================
# Kisaan Dost Environment Variables Configuration Template
# ==============================================================================

# Application & Environment
APP_NAME="Kisaan Dost MVP"
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# Authentication & Security
JWT_SECRET_KEY=change-this-secret-key-in-every-environment
JWT_ACCESS_TOKEN_MINUTES=60
JWT_ALGORITHM=HS256

# Database Configuration (PostgreSQL 14+)
# If DATABASE_URL is not set or unreachable, the system falls back to JSON / SQLite store.
DATABASE_URL=postgresql://kisaan_user:your_db_password_here@localhost:5432/kisaan_dost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisaan_dost
DB_USER=kisaan_user
DB_PASSWORD=your_db_password_here
USE_DATABASE=true

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=5.0

# Real Agricultural & Research API Keys
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
FAO_API_KEY=your_fao_key_here
PAKISTAN_DATA_API_KEY=your_pakistan_data_key_here
NASA_EARTHDATA_API_KEY=your_nasa_earthdata_key_here
CABI_API_KEY=your_cabi_key_here
GOOGLE_API_KEY=your_google_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
